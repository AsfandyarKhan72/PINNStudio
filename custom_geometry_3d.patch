+                f"(_x1_{idx},_y1_{idx},_z0_{idx}),(_x0_{idx},_y1_{idx},_z0_{idx}),\n"
+                f"               (_x0_{idx},_y0_{idx},_z1_{idx}),(_x1_{idx},_y0_{idx},_z1_{idx}),"
+                f"(_x1_{idx},_y1_{idx},_z1_{idx}),(_x0_{idx},_y1_{idx},_z1_{idx})]\n"
