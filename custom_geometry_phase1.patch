+            patch_code = f"plt.Polygon({vlist}, closed=True, linewidth=2, edgecolor='#1971c2', facecolor='none')"
+            xs = [v[0] for v in verts]; ys = [v[1] for v in verts]
+            bbox = (min(xs), max(xs), min(ys), max(ys))
+        return geom_code, patch_code, bbox
