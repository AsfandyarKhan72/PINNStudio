+                    "Rectangle shape type instead."
+                )
+            vlist = [list(v) for v in verts]
+            if shape_type == "Triangle":
+                geom_code = f"dde.geometry.Triangle({vlist[0]}, {vlist[1]}, {vlist[2]})"
+            else:
